{
  "name": "treevision-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create treevision",
    "db:migrate:local": "wrangler d1 migrations apply treevision --local",
    "db:migrate:remote": "wrangler d1 migrations apply treevision --remote",
    "r2:create": "wrangler r2 bucket create treevision-photos",
    "tail": "wrangler tail",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "db:create:sandbox": "wrangler d1 create treevision-sandbox",
    "db:migrate:sandbox": "wrangler d1 migrations apply treevision-sandbox --remote",
    "r2:create:sandbox": "wrangler r2 bucket create treevision-sandbox-photos",
    "tail:sandbox": "wrangler tail --env sandbox"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
